{
  "name": "Lumen Forest Syntax",
  "colors": {
    "editor.background": "#081D15",
    "editor.foreground": "#DEECE3",
    "editorLineNumber.foreground": "#748D7C",
    "editorCursor.foreground": "#99E2B7"
  },
  "tokenColors": [
    {
      "scope": "keyword",
      "settings": {
